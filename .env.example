# Postgres connection string. Required everywhere — Prisma is the durable source
# of truth for control state.
DATABASE_URL=postgresql://user:password@host:5432/database

# Ably realtime replaces the old Vercel-hosted persistent WebSocket endpoint.
# ABLY_ROOT_KEY is server-only and publishes control state changes.
ABLY_ROOT_KEY=

# Use an Ably subscribe-only key here. This is exposed to browser clients.
NEXT_PUBLIC_ABLY_SUBSCRIBE_KEY=
NEXT_PUBLIC_ABLY_CONTROL_CHANNEL=rubenius-control-state

# Cloudinary credentials for /api/upload.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
