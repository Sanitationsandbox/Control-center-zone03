# Postgres connection string. Required everywhere — Prisma is the durable source
# of truth for control state.
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis connection string, used only to fan control-state changes out to the
# WebSocket route running on other function instances. REQUIRED IN PRODUCTION:
# without it a control command reaches only the walls attached to the same
# instance that handled the POST, and the rest silently never update.
REDIS_URL=redis://user:password@host:6379

# Cloudinary credentials for /api/upload.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
