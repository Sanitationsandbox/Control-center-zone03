# Postgres connection string. Required everywhere — Prisma is the durable source
# of truth for control state.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional direct Postgres connection for cross-instance WebSocket fan-out.
# PostgreSQL LISTEN/NOTIFY needs a session connection; transaction-mode poolers
# such as PgBouncer/Supabase :6543 cannot be used. If DATABASE_URL is a Neon
# "-pooler" URL, the app derives the direct hostname automatically. For every
# other pooler, set this explicitly in Vercel Preview and Production.
DIRECT_DATABASE_URL=postgresql://user:password@direct-host:5432/database

# Cloudinary credentials for /api/upload.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
